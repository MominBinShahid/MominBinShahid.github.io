# environment variables
.env
.env.*
!.example.env

# macOS. `Icon` + a carriage return is the custom-folder-icon file. Do NOT
# write this as `Icon?` - core.ignorecase is true on macOS, so `?` also matches
# a directory named `icons`, which silently excludes public/icons entirely.
.DS_Store
Icon[[:cntrl:]]

