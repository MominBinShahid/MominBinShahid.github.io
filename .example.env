# Both are optional. The defaults serve the site at the origin root, which is
# what production does - so a normal build needs neither of these.
#
# They exist so that "preview at a subpath" and "serve at the root" are the same
# build with one variable changed, which removes the most likely way a cutover
# breaks. Every internal link, icon and canonical URL goes through them.

# Absolute origin. Used for canonical tags, og:url, the feed and the sitemap.
# SITE_URL=https://mominbinshahid.github.io

# Path the site is served from. Must have a trailing slash.
# BASE_PATH=/preview/
